                {RenderSignatureLineItemsRows(invoice, hasPharmaAddon, hasFreeScheme, hasMrp, hasDiscount, hasPtr, hasPts)}
                {((invoice?.Items?.Count ?? (invoice == null ? 2 : 0)) < 12 ? RenderTableFillerRow(colCount, "#1e293b", (invoice?.Items?.Count ?? (invoice == null ? 2 : 0)), IsA5Size(t) ? 120 : 420) : "")}
