                <div style='{sigFont} font-weight:800; color:#0f172a;'>For {sellerName}</div>
                <div style='{sigGap}'></div>
                <div style='border-top:1px solid #64748b; display:inline-block; padding-top:1px; {sigFont} font-weight:700; color:#0f172a;'>
