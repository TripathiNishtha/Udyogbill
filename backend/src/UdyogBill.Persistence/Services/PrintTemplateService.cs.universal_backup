    <!-- 2. LINE ITEMS TABLE WITH UNBROKEN VERTICAL GRID LINES REACHING BOTTOM -->
    <div style='flex: 1 1 auto; display: flex; flex-direction: column;'>
        <table style='width: 100%; border-collapse: collapse; font-size: 9px;'>
