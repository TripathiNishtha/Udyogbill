                <div style='margin-top: 3px; font-family: monospace; font-size: 8.5px;'>
                    {(!string.IsNullOrWhiteSpace(vendorGstin) ? $"<span><strong>GSTIN:</strong> {vendorGstin}</span>" : "")}
