        string declFont = isA5 ? "font-size:8.5px; line-height:1.2; font-weight:600;" : "font-size:9px; line-height:1.35;";
        string sigGap = isA5 ? "height:12px;" : "height:34px;";
        string sigFont = isA5 ? "font-size:9px; font-weight:800;" : "font-size:9.5px;";
        string footerPad = isA5 ? "padding:1px 8px; font-size:8.5px; font-weight:700;" : "padding:3px 12px; font-size:8.5px;";

        return $@"
<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8' />
    <title>{headerTitle} - {invNo}</title>
    <link rel='preconnect' href='https://fonts.googleapis.com'>
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
    <link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap' rel='stylesheet'>
    <style>
        {pageCss}
        html, body {{ margin:0; padding:0; background:#ffffff; color:{darkSlate}; font-family:'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; -webkit-print-color-adjust:exact; print-color-adjust:exact; }}
        .enterprise-invoice {{ {containerCss} }}
        table {{ border-collapse:collapse; width:100%; page-break-inside:auto; }}
        tr {{ page-break-inside:avoid; break-inside:avoid; }}
        th, td {{ box-sizing:border-box; }}
    </style>
</head>
<body>
<div class='enterprise-invoice'>

    <div style='display:flex; flex-direction:column; flex:1 1 auto; min-height:0;'>
        <!-- 1. TOP STATUTORY HEADER RIBBON (Executive Royal Indigo) -->
        <div style='background:#ffffff; color:#0f172a; {headerPad} border-bottom:{(isA5 ? "1.5px" : "2px")} solid {primaryOrange};'>
            <div style='display:flex; justify-content:space-between; align-items:flex-start;'>
                <!-- Left: Seller Branding & License Info -->
                <div style='max-width:65%;'>
                    <div style='display:flex; align-items:center; gap:8px;'>
                        {(!string.IsNullOrEmpty(logoUrl) ? $"<img src='{logoUrl}' alt='Logo' style='{logoStyle}' />" : "")}
                        <div>
                            <h1 style='margin:0; {sellerTitleStyle} text-transform:uppercase; letter-spacing:0.3px; color:{primaryGreen};'>{sellerName}</h1>
                            {(!string.IsNullOrWhiteSpace(sellerLegalName) && sellerLegalName != sellerName ? $"<div style='{sellerLegalFont} color:#475569; font-weight:600;'>({sellerLegalName})</div>" : "")}
                        </div>
                    </div>
                    
                    <div style='{sellerSubStyle} color:#334155;'>{sellerAddress}</div>
                    
                    <div style='{sellerChipsStyle}'>
                        {(!string.IsNullOrEmpty(sellerGstin) ? $"<span style='background:#f1f5f9; border:1px solid #cbd5e1; padding:0 4px; border-radius:3px; color:#0f172a;'>GSTIN: <strong>{sellerGstin}</strong></span>" : "")}
                        {(!string.IsNullOrEmpty(sellerPan) ? $"<span style='background:#f1f5f9; border:1px solid #cbd5e1; padding:0 4px; border-radius:3px; color:#0f172a;'>PAN: <strong>{sellerPan}</strong></span>" : "")}
                        {(!string.IsNullOrEmpty(sellerDl) ? $"<span style='background:#f1f5f9; border:1px solid #cbd5e1; padding:0 4px; border-radius:3px; color:#0f172a;'>D.L.: <strong>{sellerDl}</strong></span>" : "")}
                        {(!string.IsNullOrEmpty(sellerFssai) ? $"<span style='background:#f1f5f9; border:1px solid #cbd5e1; padding:0 4px; border-radius:3px; color:#0f172a;'>FSSAI: <strong>{sellerFssai}</strong></span>" : "")}
                        {(!string.IsNullOrEmpty(sellerPhone) ? $"<span style='color:#334155;'>Ph: <strong>{sellerPhone}</strong></span>" : "")}
                        {(!string.IsNullOrEmpty(sellerEmail) ? $"<span style='color:#334155;'>Email: <strong>{sellerEmail}</strong></span>" : "")}
                    </div>
                </div>

                <!-- Right: Invoice Type & Rule 48 Status + Verification QR (Instant Data URI) -->
                <div style='display:flex; align-items:center; gap:10px;'>
                    <div style='text-align:right;'>
                        <div style='background: linear-gradient(135deg, {primaryOrange}, #c2410c); color:#ffffff; {badgeStyle} display:inline-block; letter-spacing:0.8px; box-shadow:0 2px 4px rgba(234,88,12,0.25);'>
                            {headerTitle}
                        </div>
                        <div style='margin-top:3px;'>
                            <div style='{(isA5 ? "font-size:7.5px;" : "font-size:8.5px;")} color:#64748b; font-weight:700; text-transform:uppercase; letter-spacing:0.3px;'>Invoice No:</div>
                            <div style='font-family:monospace; {(isA5 ? "font-size:11px;" : "font-size:14px;")} font-weight:900; color:{primaryOrange}; letter-spacing:0.5px; line-height:1.2;'>{invNo}</div>
                        </div>
                        <div style='{(isA5 ? "font-size:7.5px;" : "font-size:9px;")} color:#475569; margin-top:2px;'>State: <strong>{sellerState}</strong></div>
                    </div>
                    {(invoice != null ? $@"
                    <div style='border:1px solid #cbd5e1; border-radius:4px; padding:2px; background:#ffffff; text-align:center;'>
                        <img src='{GenerateQrCodeDataUri($"https://udyogbill.com/i/{invoice.Id}", 4)}' alt='Digital Bill' style='width:{(isA5 ? "38px" : "50px")}; height:{(isA5 ? "38px" : "50px")}; display:block;' />
                        <span style='font-size:6.5px; font-weight:700; color:#64748b; text-transform:uppercase; display:block; margin-top:1px;'>Scan to View</span>
                    </div>" : "")}
                </div>
            </div>
        </div>

        <!-- 2. INVOICE META STRIP (High-Contrast Quick Read Bar) -->
        <div style='display:grid; grid-template-columns: repeat(4, 1fr); background:#f1f5f9; border-bottom:1.5px solid {borderSlate}; {metaPad}'>
            <div>
                <span style='color:#000000; {(isA5 ? "font-size:8px;" : "font-size:8.5px;")} text-transform:uppercase; font-weight:800;'>Invoice Number:</span><br/>
                <strong style='font-family:monospace; {metaInvFont} color:{primaryOrange};'>{invNo}</strong>
            </div>
            <div>
                <span style='color:#000000; {(isA5 ? "font-size:8px;" : "font-size:8.5px;")} text-transform:uppercase; font-weight:800;'>Invoice Date &amp; Time:</span><br/>
                <strong style='color:#000000; {(isA5 ? "font-size:10px;" : "font-size:10.5px;")} font-weight:800;'>{invDate}</strong> <span style='{(isA5 ? "font-size:8px;" : "font-size:8.5px;")} color:#000000; font-weight:700;'>({invTime})</span>
            </div>
            <div>
                <span style='color:#000000; {(isA5 ? "font-size:8px;" : "font-size:8.5px;")} text-transform:uppercase; font-weight:800;'>Place of Supply:</span><br/>
                <strong style='color:#000000; {(isA5 ? "font-size:10px;" : "font-size:10.5px;")} font-weight:800;'>{placeOfSupply}</strong>
            </div>
            <div style='text-align:right;'>
                <span style='color:#000000; {(isA5 ? "font-size:8px;" : "font-size:8.5px;")} text-transform:uppercase; font-weight:800;'>Reverse Charge:</span><br/>
                <strong style='color:{primaryGreen}; {(isA5 ? "font-size:9.5px;" : "font-size:10px;")} font-weight:900;'>NO (Forward Charge)</strong>
            </div>
        </div>

        <!-- IRN / E-Invoice Strip if generated -->
        {(!string.IsNullOrEmpty(irn) ? $@"
        <div style='background:#f8fafc; border-bottom:1px solid #cbd5e1; {(isA5 ? "padding:2px 8px; font-size:8px;" : "padding:4px 12px; font-size:8.5px;")} display:flex; justify-content:space-between; align-items:center;'>
            <div style='color:#000000; font-weight:600;'><strong>IRN:</strong> <span style='font-family:monospace; word-break:break-all;'>{irn}</span></div>
            {(!string.IsNullOrEmpty(ackNo) ? $"<div style='color:#000000; font-weight:600;'><strong>Ack:</strong> {ackNo} ({ackDate})</div>" : "")}
        </div>" : "")}

        <!-- 3. DUAL PARTY DETAILS: BILLED TO & SHIPPED TO -->
        <div style='display:grid; grid-template-columns: 1fr 1fr; border-bottom:1.5px solid {borderSlate};'>
            <!-- BILL TO -->
            <div style='{partyPad} border-right:1px solid {borderSlate}; background:#ffffff;'>
                <div style='display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #e2e8f0; padding-bottom:2px; margin-bottom:2px;'>
                    <span style='{partyTitleFont} font-weight:900; color:{primaryGreen}; text-transform:uppercase; letter-spacing:0.5px;'>Details of Receiver | Billed To:</span>
                    <span style='{(isA5 ? "font-size:7.5px;" : "font-size:8px;")} font-weight:800; color:#ffffff; background:{primaryGreen}; padding:1px 5px; border-radius:2px;'>
                        {(isB2B ? "REGISTERED B2B" : "RETAIL CONSUMER")}
                    </span>
                </div>
                <div style='{partyNameFont} font-weight:900; color:#000000;'>{custName}</div>
                {(!string.IsNullOrEmpty(custAddress) ? $"<div style='{partySubFont} color:#000000; font-weight:600;'>{custAddress}</div>" : "")}
                
                <div style='{partyChipsFont} color:#000000;'>
                    {(!string.IsNullOrEmpty(custGstin) ? $"<span>GSTIN: <strong style='font-family:monospace; color:{primaryOrange}; font-weight:900;'>{custGstin}</strong></span>" : "<span style='color:#000000; font-weight:700;'>Unregistered Buyer</span>")}
                    {(!string.IsNullOrEmpty(custPan) ? $"<span>PAN: <strong style='font-family:monospace; font-weight:800;'>{custPan}</strong></span>" : "")}
                    {(!string.IsNullOrEmpty(custPhone) ? $"<span>Mobile: <strong style='font-weight:800;'>{custPhone}</strong></span>" : "")}
                    {(!string.IsNullOrEmpty(custStateCode) ? $"<span>State Code: <strong style='font-weight:800;'>{custStateCode}</strong></span>" : "")}
                    {(!string.IsNullOrEmpty(custDl) ? $"<span>Drug Lic: <strong style='font-weight:800;'>{custDl}</strong></span>" : "")}
                </div>
            </div>

            <!-- SHIP TO -->
            <div style='{partyPad} background:{lightBg};'>
                <div style='display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #e2e8f0; padding-bottom:2px; margin-bottom:2px;'>
                    <span style='{partyTitleFont} font-weight:900; color:#000000; text-transform:uppercase; letter-spacing:0.5px;'>Consignee | Shipped To:</span>
                    <span style='{(isA5 ? "font-size:7.5px;" : "font-size:8px;")} font-weight:700; color:#000000;'>Destination Site</span>
                </div>
                <div style='{partyNameFont} font-weight:900; color:#000000;'>{custName}</div>
                <div style='{partySubFont} color:#000000; font-weight:600;'>{shipAddress}</div>
                <div style='margin-top:2px; {(isA5 ? "font-size:8px;" : "font-size:9px;")} color:#000000;'>
                    Place of Delivery: <strong>{placeOfSupply}</strong> | Country: <strong>India</strong>
                </div>
            </div>
        </div>

        <!-- 4. LOGISTICS & TRANSPORT STRIP (Auto-collapses if no logistics data) -->
        {(hasLogistics ? $@"
        <div style='background:#f8fafc; border-bottom:1.5px solid {borderSlate}; {logisticsPad}'>
            <div style='display:grid; grid-template-columns: repeat(5, 1fr); gap:4px; {logisticsFont}'>
                <div><span style='color:#64748b;'>Transporter:</span><br/><strong style='color:#0f172a;'>{(!string.IsNullOrEmpty(transporter) ? transporter : "-")}</strong></div>
                <div><span style='color:#64748b;'>Vehicle No:</span><br/><strong style='font-family:monospace; color:#0f172a;'>{(!string.IsNullOrEmpty(vehicleNo) ? vehicleNo : "-")}</strong></div>
                <div><span style='color:#64748b;'>LR / Bilty:</span><br/><strong style='color:#0f172a;'>{(!string.IsNullOrEmpty(lrNo) ? $"{lrNo} ({lrDate})" : "-")}</strong></div>
                <div><span style='color:#64748b;'>E-Way Bill:</span><br/><strong style='font-family:monospace; color:{primaryOrange};'>{(!string.IsNullOrEmpty(eWayNo) ? eWayNo : "-")}</strong></div>
                <div><span style='color:#64748b;'>Buyer PO Ref:</span><br/><strong style='color:#0f172a;'>{(!string.IsNullOrEmpty(poNo) ? $"{poNo} ({poDate})" : "-")}</strong></div>
            </div>
        </div>" : "")}

        <!-- Doctor Prescriber Strip if Pharma Statutory -->
        {(hasPrescriptionInfo ? $@"
        <div style='background:#fef2f2; border-bottom:1px solid #fecaca; {(isA5 ? "padding:2px 8px; font-size:7.5px;" : "padding:4px 12px; font-size:9px;")} display:flex; justify-content:space-between; color:#991b1b;'>
            <div><strong>Prescribing Doctor:</strong> {(!string.IsNullOrEmpty(doctorName) ? doctorName : "-")} {(!string.IsNullOrEmpty(doctorRegNo) ? $"(Reg: {doctorRegNo})" : "")}</div>
            <div><strong>Patient Name:</strong> {(!string.IsNullOrEmpty(patientName) ? patientName : "-")} {(!string.IsNullOrEmpty(patientContact) ? $"| Phone: {patientContact}" : "")}</div>
            <div style='font-weight:bold;'>PRESCRIPTION / RX</div>
        </div>" : "")}

        <!-- Automotive Vehicle & Mechanic Job Strip if Auto Parts -->
        {(hasAutoPartsInfo ? $@"
        <div style='background:#f0f9ff; border-bottom:1.5px solid #0284c7; {(isA5 ? "padding:2.5px 8px; font-size:8px;" : "padding:4px 12px; font-size:9.5px;")} display:flex; justify-content:space-between; color:#0369a1; align-items:center;'>
            <div style='display:flex; gap:14px; flex-wrap:wrap;'>
                {(!string.IsNullOrEmpty(vehicleNo) ? $"<div><strong>Vehicle / Reg No:</strong> <span style='font-family:monospace; font-weight:800; color:#0284c7;'>{vehicleNo}</span></div>" : "")}
                {(!string.IsNullOrEmpty(autoVehicleModel) ? $"<div><strong>Vehicle Model:</strong> <span style='font-weight:700;'>{autoVehicleModel}</span></div>" : "")}
                {(!string.IsNullOrEmpty(autoMechanicName) ? $"<div><strong>Mechanic / Mistri:</strong> <span style='font-weight:700;'>{autoMechanicName}</span></div>" : "")}
                {(!string.IsNullOrEmpty(autoOdometerKm) ? $"<div><strong>Odometer:</strong> <span style='font-weight:700;'>{autoOdometerKm} KM</span></div>" : "")}
            </div>
            <div style='font-weight:800; font-size:{(isA5 ? "7.5px" : "8.5px")}; text-transform:uppercase; color:#0284c7; background:#e0f2fe; padding:1px 6px; border-radius:3px; border:1px solid #7dd3fc;'>
                AUTOMOTIVE JOB / FITMENT
            </div>
        </div>" : "")}

        <!-- 5. DYNAMIC LINE ITEMS TABLE (Color-Accent Header, Crisp Borders) -->
        <div style='flex:1 1 auto; display:flex; flex-direction:column; min-height:0;'>
            <table style='width:100%; height:100%; flex:1 1 auto; border-collapse:collapse; display:table;'>
                <thead>
                    <tr style='background:{lightGreenBg}; color:{primaryGreen}; border-bottom:1.5px solid {greenBorder};'>
                        <th style='{thStyle} width:{(isA5 ? "20px" : "26px")}; text-align:center; border-right:1px solid {greenBorder};'>#</th>
                        <th style='{thLeftStyle} text-align:left; border-right:1px solid {greenBorder};'>Description of Goods / Services</th>
                        <th style='{thStyle} width:{(isA5 ? "48px" : "60px")}; text-align:center; border-right:1px solid {borderSlate};'>HSN/SAC</th>
                        {(hasPack ? $"<th style='{thStyle} width:{(isA5 ? "38px" : "50px")}; text-align:center; border-right:1px solid {borderSlate};'>Packing</th>" : "")}
                        {(hasSerial ? $"<th style='{thStyle} width:{(isA5 ? "75px" : "100px")}; text-align:center; border-right:1px solid {borderSlate};'>IMEI / Serial</th>" : "")}
                        {(hasBatch ? $"<th style='{thStyle} width:{(isA5 ? "55px" : "72px")}; text-align:center; border-right:1px solid {borderSlate};'>Batch</th>" : "")}
                        {(hasExpiry ? $"<th style='{thStyle} width:{(isA5 ? "38px" : "48px")}; text-align:center; border-right:1px solid {borderSlate};'>Expiry</th>" : "")}
                        <th style='{thStyle} width:{(isA5 ? "44px" : "58px")}; text-align:right; border-right:1px solid {borderSlate};'>Qty</th>
                        {(hasFree ? $"<th style='{thStyle} width:{(isA5 ? "32px" : "40px")}; text-align:center; border-right:1px solid {borderSlate};'>Free</th>" : "")}
                        {(hasMrp ? $"<th style='{thStyle} width:{(isA5 ? "48px" : "60px")}; text-align:right; border-right:1px solid {borderSlate};'>MRP</th>" : "")}
                        <th style='{thStyle} width:{(isA5 ? "50px" : "64px")}; text-align:right; border-right:1px solid {borderSlate};'>Unit Rate</th>
                        {(hasDisc ? $"<th style='{thStyle} width:{(isA5 ? "36px" : "46px")}; text-align:center; border-right:1px solid {borderSlate};'>Disc</th>" : "")}
                        <th style='{thStyle} width:{(isA5 ? "36px" : "44px")}; text-align:center; border-right:1px solid {borderSlate};'>GST%</th>
                        <th style='{thStyle} width:{(isA5 ? "64px" : "80px")}; text-align:right;'>Net Amount</th>
                    </tr>
                </thead>
                <tbody style='height:100%;'>
                    {itemsRows}
                </tbody>
            </table>
        </div>
    </div>

    <!-- 6. BOTTOM SECTION: HSN TAX SUMMARY, WORDS, BANK DETAILS & SETTLEMENT -->
    <div style='border-top:1.5px solid {borderSlate};'>
        <!-- HSN Summary Table -->
        {hsnSummaryTable}

        <!-- Total Calculation & Bank Strip -->
        <div style='display:grid; grid-template-columns: 1.25fr 0.95fr; border-top:1.5px solid {borderSlate};'>
            <!-- Left: Amount in Words & Bank UPI Settlement -->
            <div style='{bottomPad} border-right:1px solid {borderSlate}; background:#ffffff;'>
                <div style='background:#f8fafc; border:1px solid #cbd5e1; border-radius:4px; {wordsBoxPad}'>
                    <div style='{wordsTitleFont} font-weight:800; color:#000000; text-transform:uppercase;'>Amount Chargeable (in words):</div>
                    <div style='{wordsValFont} font-weight:900; color:#000000;'>INR {words}</div>
                </div>

                <!-- Bank & UPI QR Card -->
                {(showSettlementCard ? $@"
                <div style='{settlementPad}'>
                    {(!string.IsNullOrEmpty(upiQr) ? $"<img src='{upiQr}' alt='UPI QR' style='{qrImgStyle}' />" : "")}
                    <div style='{bankDetailsFont} flex:1; color:#000000;'>
                        <div style='font-weight:900; color:{primaryOrange}; {bankTitleFont} text-transform:uppercase;'>Bank &amp; UPI Settlement</div>
                        {(!string.IsNullOrEmpty(bankName) ? $"<div>Bank: <strong style='color:#000000;'>{bankName}</strong>{(!string.IsNullOrEmpty(bankBranch) ? $" ({bankBranch})" : "")}</div>" : "")}
                        {(!string.IsNullOrEmpty(bankAcc) ? $"<div>A/c No: <strong style='font-family:monospace; color:#000000; font-size:{(isA5 ? "10.5px" : "11px")}; font-weight:900;'>{bankAcc}</strong></div>" : "")}
                        {(!string.IsNullOrEmpty(bankIfsc) ? $"<div>IFSC: <strong style='font-family:monospace; color:#000000; font-weight:800;'>{bankIfsc}</strong></div>" : "")}
                        {(!string.IsNullOrEmpty(upiId) ? $"<div>UPI ID: <strong style='font-family:monospace; color:{primaryGreen}; font-weight:800;'>{upiId}</strong></div>" : "")}
                    </div>
                </div>" : "")}
            </div>

            <!-- Right: Commercial Totals Breakdown (Up to 10 Cr Scale) -->
            <div style='{bottomPad} background:#f8fafc;'>
                <table style='{totalsTableFont} width:100%; border-collapse:collapse; color:#000000;'>
                    <tr>
                        <td style='{totalsRowPad} color:#000000; font-weight:700;'>Taxable Amount:</td>
                        <td style='{totalsRowPad} text-align:right; font-family:monospace; font-weight:900; color:#000000; {(isA5 ? "font-size:11px;" : "font-size:11.5px;")}'>₹{taxable:N2}</td>
                    </tr>
                    {(cgst > 0 ? $@"
                    <tr>
                        <td style='{totalsRowPad} color:#000000; font-weight:700;'>Central Tax (CGST):</td>
                        <td style='{totalsRowPad} text-align:right; font-family:monospace; font-weight:900; color:#000000; {(isA5 ? "font-size:11px;" : "font-size:11.5px;")}'>₹{cgst:N2}</td>
                    </tr>" : "")}
                    {(sgst > 0 ? $@"
                    <tr>
                        <td style='{totalsRowPad} color:#000000; font-weight:700;'>State Tax (SGST):</td>
                        <td style='{totalsRowPad} text-align:right; font-family:monospace; font-weight:900; color:#000000; {(isA5 ? "font-size:11px;" : "font-size:11.5px;")}'>₹{sgst:N2}</td>
                    </tr>" : "")}
                    {(igst > 0 ? $@"
                    <tr>
                        <td style='{totalsRowPad} color:#000000; font-weight:700;'>Integrated Tax (IGST):</td>
                        <td style='{totalsRowPad} text-align:right; font-family:monospace; font-weight:900; color:#000000; {(isA5 ? "font-size:11px;" : "font-size:11.5px;")}'>₹{igst:N2}</td>
                    </tr>" : "")}
                    {(cess > 0 ? $@"
                    <tr>
                        <td style='{totalsRowPad} color:#000000; font-weight:700;'>GST Cess:</td>
                        <td style='{totalsRowPad} text-align:right; font-family:monospace; font-weight:900; color:#000000; {(isA5 ? "font-size:11px;" : "font-size:11.5px;")}'>₹{cess:N2}</td>
                    </tr>" : "")}
                    {(roundOff != 0 ? $@"
                    <tr>
                        <td style='{totalsRowPad} color:#000000; font-weight:700;'>Round Off:</td>
                        <td style='{totalsRowPad} text-align:right; font-family:monospace; font-weight:900; color:#000000; {(isA5 ? "font-size:11px;" : "font-size:11.5px;")}'>₹{roundOff:N2}</td>
                    </tr>" : "")}
                    <tr style='border-top:{(isA5 ? "1.5px" : "2px")} solid {primaryGreen}; background:{lightGreenBg};'>
                        <td style='{grandTotalPad} font-weight:900; color:{primaryGreen};'>GRAND TOTAL:</td>
                        <td style='{grandTotalVal} text-align:right; font-family:monospace; font-weight:900; color:{primaryGreen};'>₹{totalAmount:N2}</td>
                    </tr>
                    <tr style='border-top:1px solid #cbd5e1;'>
                        <td style='{paidDuePad} font-weight:800; color:#16a34a;'>Paid Amount:</td>
                        <td style='{paidDuePad} text-align:right; font-family:monospace; font-weight:900; color:#16a34a; {(isA5 ? "font-size:11px;" : "font-size:11.5px;")}'>₹{paidAmount:N2}</td>
                    </tr>
                    <tr style='border-top:1px dashed #cbd5e1;'>
                        <td style='{dueDuePad} font-weight:900; color:{(balanceAmount > 0 ? primaryOrange : "#000000")};'>Due Amount:</td>
                        <td style='{dueDuePad} text-align:right; font-family:monospace; font-weight:900; color:{(balanceAmount > 0 ? primaryOrange : "#000000")}; {(isA5 ? "font-size:12px;" : "font-size:12.5px;")}'>₹{balanceAmount:N2}</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- 7. DECLARATION & SIGNATURE BLOCK -->
        <div style='display:flex; justify-content:space-between; align-items:flex-end; {declPad} border-top:1px solid #e2e8f0; background:#ffffff;'>
            <div style='max-width:64%; {declFont} color:#64748b;'>
                {(!string.IsNullOrWhiteSpace(invoice?.Notes) ? $"<div style='margin-bottom:2px; color:#334155;'><strong>Notes / Remarks:</strong> {invoice.Notes}</div>" : "")}
                {(!string.IsNullOrWhiteSpace(effectiveTerms) && t.ShowTerms ? $"<div style='margin-bottom:2px;'><strong>Terms &amp; Conditions:</strong><br/>{effectiveTerms.Replace("\r\n", "<br/>").Replace("\n", "<br/>")}</div>" : "")}
                {(!string.IsNullOrWhiteSpace(t.DeclarationText) && t.ShowDeclaration ? $"<div style='margin-top:2px;'><strong>Declaration:</strong><br/>{t.DeclarationText}</div>" : "")}
            </div>
            <div style='text-align:right;'>
