        .marg-half-page {{ width: 100%; max-width: 204mm; min-height: 140mm; max-height: 144mm; height: 142mm; margin: 0 auto; box-sizing: border-box; border: 1.5px solid {primaryColor}; font-size: 9.5px; line-height: 1.3; display: flex; flex-direction: column; justify-content: space-between; }}
