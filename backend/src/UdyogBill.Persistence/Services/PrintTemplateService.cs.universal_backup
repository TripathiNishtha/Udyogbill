                <tr style='background:{headerOrangeBg}; border-bottom:1.5px solid {primaryColor}; font-weight:bold; color:#000000; height:19px;'>
                    <th style='width:22px; border-right:1px solid {borderColor}; text-align:center;'>#</th>
